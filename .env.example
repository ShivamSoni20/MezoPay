# Copy this file to `.env.local` and fill in your values:
#   cp .env.example .env.local
#
# Next.js loads `.env.local` automatically in development.

# WalletConnect / Reown — https://cloud.reown.com
# Allowlist your app URL (e.g. http://localhost:3000) under project settings.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Deployed MezoPay contracts on Mezo testnet (Chain 31611)
# Defaults below match the public testnet deployment; update if you redeploy.
NEXT_PUBLIC_REGISTRY=0x8eB4E69A550Dc63BaB674469eBC516d893793de8
NEXT_PUBLIC_SPLIT=0x9cd6D4A92939A1b93fBb3c848c2cF3e9f09D4C10

# Goldsky subgraph GraphQL endpoint (deploy your own from /subgraph, then paste URL here)
NEXT_PUBLIC_GOLDSKY_URL=https://api.goldsky.com/api/public/YOUR_PROJECT_ID/subgraphs/mezopay/VERSION/gn

# XMTP environment: dev | production | testnet (use dev for Mezo testnet development)
NEXT_PUBLIC_XMTP_ENV=dev
